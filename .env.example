# =============================================================================
# XBRL FILING PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
#
# IMPORTANT SECURITY NOTES:
# - This is a template file. Copy it to '.env' and fill in actual values.
# - NEVER commit the actual '.env' file to version control!
# - Generate secure secrets using: openssl rand -hex 32
# - Rotate credentials regularly in production environments
#
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string with asyncpg driver
# Format: postgresql+asyncpg://username:password@host:port/database
# Example: postgresql+asyncpg://postgres:mypassword@localhost:5432/xbrl_db
# REQUIRED: Yes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=xbrl_db
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-postgres-password@localhost:5433/xbrl_db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL for caching and status tracking
# Format: redis://host:port/db_number
# Default port: 6379 (change if using custom port)
# REQUIRED: Yes
REDIS_URL=redis://localhost:6380/0

# =============================================================================
# CELERY CONFIGURATION (Background Task Processing)
# =============================================================================

# Celery message broker (typically same as REDIS_URL)
# Used for queuing background tasks (PDF processing, AI extraction)
# REQUIRED: Yes
CELERY_BROKER_URL=redis://localhost:6380/0

# Celery result backend (typically same as REDIS_URL)
# Used for storing task results and status
# REQUIRED: Yes
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================

# Active production model provider.
MODEL_PROVIDER=huggingface

# Provider-neutral Hugging Face token and active Qwen model IDs.
MODEL_API_TOKEN=replace-with-your-model-provider-token
TEXT_MODEL_ID=Qwen/Qwen3-30B-A3B-Instruct-2507:featherless-ai
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=4096
EMBEDDING_NORMALIZE=true
HF_INFERENCE_TIMEOUT_SECONDS=60
HF_INFERENCE_MAX_RETRIES=2

# Legacy PDF rendering/VLM settings retained for the supported fallback path.
VISION_MODEL_ID=Qwen/Qwen2.5-VL-72B-Instruct:hyperbolic
PDF_RENDER_DPI=300
PDF_RENDER_DPI_TEXT_FAST_PATH=200
PDF_TEXT_FAST_PATH_MIN_CHARS=400
PDF_TEXT_CONTEXT_CHARS=3000
EXTRACTION_TEXT_MIN_CHARS=250
PAGE_QUALITY_MIN_TEXT_SCORE=0.55
PAGE_QUALITY_FORCE_VLM_SCORE=0.35
REGION_VLM_ENABLED=true
REGION_VLM_MAX_REGIONS=3

# Production extraction pipeline.
# Supported values: azure_di, legacy.
EXTRACTION_PIPELINE=azure_di
EXTRACTION_ALLOW_LEGACY_FALLBACK=false

# Azure Document Intelligence production extraction.
# Do not reuse MODEL_API_TOKEN here.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://replace-with-your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-with-your-azure-document-intelligence-key
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_SECONDS=180
AZURE_DOCUMENT_INTELLIGENCE_MAX_RETRIES=2
AZURE_DOCUMENT_INTELLIGENCE_PAGES=
AZURE_DI_NORMALIZATION_TIMEOUT_SECONDS=120
AZURE_DI_TEXT_BLOCKS_ENABLED=true
AZURE_DI_TEXT_BLOCK_TIMEOUT_SECONDS=15
AZURE_DI_ALLOW_TABLE_FALLBACK_ON_TEXT_TIMEOUT=true

# TOC-aware document structure foundation (#19A).
# Keep analysis and persistence disabled until a controlled rollout.
# LLM fallback is reserved and performs no model call in #19A.
TOC_AWARE_PIPELINE_ENABLED=false
TOC_AWARE_STRUCTURE_PERSISTENCE_ENABLED=false
TOC_AWARE_LLM_FALLBACK_ENABLED=false

# Canonical section-to-template classification (#19B), disabled by default.
TOC_AWARE_TEMPLATE_CLASSIFICATION_ENABLED=false
TOC_AWARE_TEMPLATE_CLASSIFICATION_PERSISTENCE_ENABLED=false
TOC_AWARE_TEMPLATE_CLASSIFICATION_LIVE_LLM_ENABLED=false
TOC_AWARE_TEMPLATE_CLASSIFICATION_MODEL_ID=Qwen/Qwen3-30B-A3B-Instruct-2507:featherless-ai
TOC_AWARE_TEMPLATE_CLASSIFICATION_MAX_CHARACTERS=12000
TOC_AWARE_TEMPLATE_CLASSIFICATION_MAX_PARAGRAPHS=12
TOC_AWARE_TEMPLATE_CLASSIFICATION_MAX_TABLE_HEADERS=12
TOC_AWARE_TEMPLATE_CLASSIFICATION_MAX_ROW_LABELS=20
TOC_AWARE_TEMPLATE_CLASSIFICATION_MAX_TEMPLATE_CARDS=8

# Section-aware advisory initial taxonomy mapping (#19C), disabled by default.
TOC_AWARE_TAXONOMY_CANDIDATE_RETRIEVAL_ENABLED=false
TOC_AWARE_INITIAL_MAPPING_ENABLED=false
TOC_AWARE_INITIAL_MAPPING_PERSISTENCE_ENABLED=false
TOC_AWARE_INITIAL_MAPPING_LIVE_LLM_ENABLED=false
TOC_AWARE_INITIAL_MAPPING_MODE=deterministic_only
TOC_AWARE_INITIAL_MAPPING_MODEL_ID=Qwen/Qwen3-235B-A22B-Instruct-2507
TOC_AWARE_INITIAL_MAPPING_MAX_CANDIDATES=8
TOC_AWARE_INITIAL_MAPPING_MAX_ROWS_PER_JOB=5000
TOC_AWARE_INITIAL_MAPPING_ROW_TIMEOUT_SECONDS=120
TOC_AWARE_INITIAL_MAPPING_MAX_CONCURRENT_CALLS=1
TOC_AWARE_INITIAL_MAPPING_MIN_CANDIDATE_SCORE=0.0
TOC_AWARE_INITIAL_MAPPING_MAX_CONTEXT_CHARACTERS=12000
TOC_AWARE_INITIAL_MAPPING_MAX_SIBLINGS=4
TOC_AWARE_INITIAL_MAPPING_MAX_ANCESTORS=3
TOC_AWARE_INITIAL_MAPPING_MAX_DESCENDANTS=3
TOC_AWARE_INITIAL_MAPPING_MAX_NEARBY_PARAGRAPHS=2

# Candidate-constrained Qwen mapping suggestions after Azure DI.
# Disabled by default; uses MODEL_API_TOKEN when live LLM mode is explicitly run.
LLM_MAPPING_ENABLED=false
LLM_MAPPING_MODEL_ID=Qwen/Qwen3-235B-A22B-Instruct-2507
LLM_MAPPING_MAX_CANDIDATES=8
LLM_MAPPING_TIMEOUT_SECONDS=60
LLM_MAPPING_HIGH_CONFIDENCE_THRESHOLD=0.88
LLM_MAPPING_MIN_DISPLAY_CONFIDENCE=0.50
LLM_MAPPING_MIN_MANUAL_CONFIDENCE=0.0
LLM_MAPPING_MAX_ROWS_PER_JOB=50
LLM_MAPPING_AUTO_APPLY_HIGH_CONFIDENCE=false

LLM_MAPPING_FEWSHOT_ENABLED=true
LLM_MAPPING_FEWSHOT_MAX_EXAMPLES=3
LLM_MAPPING_FEWSHOT_CASE_SPLIT_MODE=training_only
LLM_MAPPING_FEWSHOT_GUARDRAILS_ENABLED=true
LLM_MAPPING_FEWSHOT_FALLBACK_TO_BASE_PROMPT=true
LLM_MAPPING_PROVIDER_RATE_LIMIT_MAX_RETRIES=2
LLM_MAPPING_PROVIDER_RATE_LIMIT_BASE_DELAY_SECONDS=4
LLM_MAPPING_PROVIDER_RATE_LIMIT_MAX_DELAY_SECONDS=30
LLM_MAPPING_PROVIDER_REQUEST_DELAY_SECONDS=0.5

# Independent Supervisor LLM evaluation (#17D-B).
# Disabled by default. Do not silently reuse MODEL_API_TOKEN or mapper model IDs.
SUPERVISOR_LLM_ENABLED=false
SUPERVISOR_LLM_PROVIDER=hf
SUPERVISOR_LLM_API_TOKEN=
SUPERVISOR_LLM_MODEL_ID=
SUPERVISOR_LLM_BASE_URL=https://router.huggingface.co/v1
SUPERVISOR_LLM_RESPONSE_FORMAT=json_schema
SUPERVISOR_LLM_TIMEOUT_SECONDS=120
SUPERVISOR_LLM_MAX_RETRIES=2
SUPERVISOR_LLM_RETRY_BASE_SECONDS=3
SUPERVISOR_LLM_RETRY_MAX_SECONDS=30
SUPERVISOR_LLM_REPAIR_ENABLED=true
SUPERVISOR_LLM_MAX_REPAIR_RETRIES=1

# Production Supervisor live execution gate (#17D-C-E-A).
# Disabled by default. Live runs require explicit API mode=live and use only
# SUPERVISOR_LLM_* settings above. No mapping is auto-applied.
SUPERVISOR_PRODUCTION_LIVE_ENABLED=false
SUPERVISOR_PRODUCTION_LIVE_ADMIN_ONLY=true
SUPERVISOR_PRODUCTION_LIVE_MAX_BATCH_SIZE=10
SUPERVISOR_PRODUCTION_LIVE_DEFAULT_MODE=mock

# Manual Supervisor-to-mapper advisory correction. Disabled and non-automatic
# by default. Revised suggestions remain separate and require human review.
SUPERVISOR_MAPPER_FEEDBACK_ENABLED=false
SUPERVISOR_MAPPER_FEEDBACK_AUTO_RUN=false
SUPERVISOR_MAPPER_FEEDBACK_MAX_RETRIES=1
SUPERVISOR_MAPPER_FEEDBACK_ADMIN_ONLY=true

# Conditional Supervisor orchestration planning. This remains disabled and
# manual-only; auto review/remap values must remain false.
SUPERVISOR_ORCHESTRATION_ENABLED=false
SUPERVISOR_ORCHESTRATION_DEFAULT_MODE=manual
SUPERVISOR_ORCHESTRATION_AUTO_ELIGIBILITY=true
SUPERVISOR_ORCHESTRATION_AUTO_REVIEW=false
SUPERVISOR_ORCHESTRATION_AUTO_REMAP=false
SUPERVISOR_ORCHESTRATION_ADMIN_ONLY=true
# Comma-separated positive user IDs. Empty permits admins only.
SUPERVISOR_ORCHESTRATION_ALLOWED_USER_IDS=
SUPERVISOR_ORCHESTRATION_MAX_BATCH_SIZE=10
SUPERVISOR_ORCHESTRATION_MAX_REMAP_RETRIES=1
SUPERVISOR_ORCHESTRATION_MIN_RISK=medium
SUPERVISOR_ORCHESTRATION_MAX_CONCURRENT_LIVE_CALLS=2
SUPERVISOR_ORCHESTRATION_CONFIDENCE_THRESHOLD=0.85
SUPERVISOR_ORCHESTRATION_PER_ROW_TIMEOUT_SECONDS=120

# Deterministic rulebook mapper advisory API (#18D-D).
# Disabled by default, dry-run only, no persistence, no auto-apply.
RULEBOOK_MAPPER_ADVISORY_ENABLED=false
RULEBOOK_MAPPER_ADVISORY_DEFAULT_MODE=dry_run
RULEBOOK_MAPPER_ADVISORY_ALLOW_PERSISTENCE=false

# Ranked taxonomy candidates remain disabled, dry-run only, and non-persistent.
RANKED_CANDIDATES_ADVISORY_ENABLED=false
RANKED_CANDIDATES_ADVISORY_DEFAULT_MODE=dry_run
RANKED_CANDIDATES_ADVISORY_ALLOW_PERSISTENCE=false
RANKED_CANDIDATES_ADVISORY_DEFAULT_PROFILE=balanced
RANKED_CANDIDATES_ADVISORY_MAX_ROWS=1000
RANKED_CANDIDATES_ADVISORY_MAX_CANDIDATES_PER_ROW=5
RANKED_CANDIDATES_ADVISORY_ADMIN_ONLY=true

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# Directory for uploaded PDFs and extracted images
# Relative or absolute path supported
# Default: uploads
# REQUIRED: No
UPLOAD_DIRECTORY=uploads

# Maximum file size for PDF uploads in bytes
# Default: 52428800 (50 MB)
# Adjust based on your server capacity
# REQUIRED: No
MAX_FILE_SIZE=52428800

# Maximum number of PDF pages accepted for processing
# Default: 300
# REQUIRED: No
MAX_PDF_PAGES=300

# Temporary directory for file processing (Windows specific)
# Used during PDF rendering and image extraction
# Default: C:\temp\xbrl
# REQUIRED: No (Windows only, auto-created if missing)
TEMP_DIRECTORY=C:\temp\xbrl

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Server auth secret used to sign bearer tokens.
# IMPORTANT: Generate a secure random key for every environment.
# Generate with: openssl rand -hex 32
# REQUIRED: Yes
SECRET_KEY=generate-with-openssl-rand-hex-32

# Optional development/controlled-deployment bootstrap account.
# The account is created only when enabled and only if the email is not already present.
# The plaintext password is never logged and is stored only as a password hash.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-bootstrap-password

# Shared backend token required for temporary protection on dangerous routes.
# Send it as the X-Admin-Token header for protected maintenance/destructive/export operations.
# This is a stopgap only; replace it with real login/auth in a later feature.
ADMIN_ROUTE_TOKEN=replace-with-random-admin-route-token

# Comma-separated browser origins allowed to call the API.
# Keep this specific; do not use "*" when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# =============================================================================
# PERFORMANCE & CACHING CONFIGURATION
# =============================================================================

# Cache time-to-live in seconds
# How long to cache general application data
# Default: 3600 (1 hour)
# REQUIRED: No
CACHE_TTL=3600

# Search result cache TTL in seconds
# How long to cache taxonomy search results
# Default: 14400 (4 hours)
# REQUIRED: No
SEARCH_CACHE_TTL=14400

# Default pagination page size
# Number of items per page in API responses
# Default: 50
# REQUIRED: No
PAGE_SIZE=50

# Slow query threshold in seconds
# Log queries that take longer than this value
# Useful for performance monitoring
# Default: 2.0
# REQUIRED: No
SLOW_QUERY_THRESHOLD=2.0

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Enable debug mode.
# Default is false for safer local and deployment behavior.
# REQUIRED: No
DEBUG=false

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# REQUIRED: No
LOG_LEVEL=INFO

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# For Production Deployment:
# 1. Set DEBUG=false
# 2. Use strong, unique SECRET_KEY
# 3. Use production-grade database with backups
# 4. Enable SSL/TLS for all connections
# 5. Restrict network access to Redis and PostgreSQL
# 6. Monitor model provider API usage and costs
# 7. Set up proper logging and monitoring
# 8. Configure firewall rules
# 9. Use environment-specific .env files
# 10. Implement rate limiting and request validation
#
# For Development:
# 1. Use local PostgreSQL and Redis instances
# 2. Temporarily enable DEBUG only for local troubleshooting
# 3. LOG_LEVEL=DEBUG for verbose logging
# 4. Smaller cache TTLs for testing
#
# =============================================================================

# Frontend Review Workspace visibility flags.
# These are build-time Vite flags and are not security controls.

# Local Vite proxy target. Production builds use same-origin /api requests.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8001

# Keep the internal/test-stage AI Mapping Suggestions panel visible by default.
VITE_SHOW_AI_SUGGESTION_PANEL=true

# Deprecated frontend visibility setting. Mock execution remains available to
# backend tests and omitted-mode requests, but the application renders no mock controls.
VITE_SHOW_SUPERVISOR_MOCK_CONTROLS=false

# Live Supervisor controls stay hidden unless explicitly enabled for test use.
# Backend feature flags and permissions remain authoritative for live execution.
VITE_SHOW_SUPERVISOR_LIVE_CONTROLS=false

# Manual Supervisor-guided mapper correction. Hidden by default. The backend
# feature flag, ownership, permission, eligibility, and retry gates remain authoritative.
VITE_SHOW_SUPERVISOR_MAPPER_FEEDBACK=false

# Calibrated local Supervisor eligibility queue. Hidden by default. This flag
# controls visibility only; backend orchestration gates remain authoritative.
VITE_SHOW_SUPERVISOR_ORCHESTRATION_QUEUE=false

# Ranked candidate dry-run panel for internal testing only. It is read-only,
# remains hidden by default, and cannot enable backend advisory execution.
VITE_SHOW_RANKED_CANDIDATE_TEST_PANEL=false
